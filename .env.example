# 운영 방식: personal (기본), shared, server
CODEWITH_MODE=personal
# shared/server 기본 인증은 key. server에서만 아래 방식을 조합할 수 있습니다.
# CODEWITH_AUTH_METHODS=key,passkey,email,oidc
# 패스키/이메일/SSO 사용 시 HTTPS 도메인 필수 (개발용 http://localhost 허용)
# CODEWITH_ORIGIN=https://codewith.example.com
# 이메일 인증:
# CODEWITH_SMTP_URL=smtps://USER:PASSWORD@smtp.example.com:465
# CODEWITH_MAIL_FROM=CodeWith <no-reply@example.com>
# 조직 SSO (OpenID Connect):
# CODEWITH_OIDC_ISSUER=https://login.example.com/realms/company
# CODEWITH_OIDC_CLIENT_ID=codewith
# CODEWITH_OIDC_CLIENT_SECRET=
# CODEWITH_OIDC_LABEL=회사 계정
# 등록할 콜백: https://codewith.example.com/api/auth/oidc/callback

# No database setting: use .codewith/database.json.
CODEWITH_DATABASE_URL=
# Examples (choose one; do not commit real credentials):
# CODEWITH_DATABASE_URL=sqlite:codewith.sqlite
# CODEWITH_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/codewith
# CODEWITH_DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/codewith
# CODEWITH_DATABASE_URL=mariadb://USER:PASSWORD@HOST:3306/codewith

# Optional custom adapter for another database, trusted server module only:
# CODEWITH_STORAGE_ADAPTER=/absolute/path/to/adapter.mjs

# Explicit one-time copy of database.json into an EMPTY selected database:
# CODEWITH_IMPORT_FILE=1
# CODEWITH_DATA_DIR=/absolute/path/to/codewith-data
# CODEWITH_ORIGIN=https://codewith.example.com
# personal 기본 HOST=127.0.0.1, shared/server 기본 HOST=0.0.0.0
# 프록시 뒤에서만 제공할 때: HOST=127.0.0.1
# PORT=4310

# shared/server에서 연결을 허용할 프로젝트 상위 폴더 (personal은 지정 불필요)
# Linux/WSL은 콜론, Windows는 세미콜론으로 여러 경로 구분
# CODEWITH_PROJECT_ROOTS=/srv/projects:/opt/team-code

# 별도 운영 JSON: 환경변수 > 이 파일 > config/runtime.defaults.json
# CODEWITH_CONFIG_FILE=./config/runtime.local.json
# CLI 실행 경로 (선택)
# CODEWITH_CODEX_BIN=codex
# CODEWITH_CLAUDE_BIN=claude
# 실행 설정 전체 설명: config/README.md. 시간 단위를 확인하세요.
# 전체 계획 실행 제한(초), 작성·검토·수정·평가 합산
# CODEWITH_PLAN_TIMEOUT_SECONDS=1800
# Codex·Claude Code 요청 하나의 실행 제한(ms)
# CODEWITH_AI_REQUEST_TIMEOUT_MS=1800000
# Codex RPC 일반 응답 제한(ms)
# CODEWITH_RPC_TIMEOUT_MS=30000
# Codex 실행 시작 RPC 제한(ms)
# CODEWITH_RPC_START_TIMEOUT_MS=60000
# Codex 로그인 RPC 제한(ms)
# CODEWITH_RPC_LOGIN_TIMEOUT_MS=45000
# Codex 중지 RPC 제한(ms)
# CODEWITH_RPC_INTERRUPT_TIMEOUT_MS=5000
# CLI 초기화 제한(ms)
# CODEWITH_CLI_STARTUP_TIMEOUT_MS=15000
# CLI 버전 확인 제한(ms)
# CODEWITH_CLI_PROBE_TIMEOUT_MS=10000
# CLI 종료 대기(ms)
# CODEWITH_CLI_SHUTDOWN_GRACE_MS=1500
# API 모델 목록 조회 제한(ms)
# CODEWITH_MODEL_LIST_TIMEOUT_MS=20000
# Claude Code 최대 수신 문자 수
# CODEWITH_CLAUDE_OUTPUT_MAX_CHARS=6000000
# Claude API 기본 출력 토큰 수
# CODEWITH_CLAUDE_MAX_TOKENS=8192
# Claude 외부 조사 출력 토큰 수
# CODEWITH_RESEARCH_MAX_TOKENS=4096
# Claude 문서 읽기 최대 토큰 수
# CODEWITH_RESEARCH_CONTENT_TOKENS=10000
# Claude 외부 조사 최대 반복 수
# CODEWITH_RESEARCH_MAX_TURNS=3
# 조사 요청별 검색/읽기 도구 사용 수
# CODEWITH_RESEARCH_MAX_TOOL_USES=3
# SSE 연결 유지 주기(ms)
# CODEWITH_SSE_HEARTBEAT_MS=15000
# AI 실행 기록 저장 지연(ms)
# CODEWITH_RUN_PERSIST_DEBOUNCE_MS=300
# 인증 흐름 정리 주기(ms)
# CODEWITH_FLOW_SWEEP_MS=60000
# PDF·DOCX 본문 읽기 제한(ms)
# CODEWITH_DOCUMENT_READ_TIMEOUT_MS=20000
# DB 연결 제한(ms)
# CODEWITH_DATABASE_CONNECT_TIMEOUT_MS=10000
# DB 쿼리 제한(ms)
# CODEWITH_DATABASE_QUERY_TIMEOUT_MS=15000
# SQLite 잠금 대기(ms)
# CODEWITH_SQLITE_BUSY_TIMEOUT_MS=5000
# 최초 계획 입력 최대 문자 수
# CODEWITH_PLAN_PROMPT_MAX_CHARS=400000
# 일반 채팅 입력 최대 문자 수
# CODEWITH_CHAT_PROMPT_MAX_CHARS=400000
# 계획 검토·수정 입력 최대 문자 수
# CODEWITH_PLAN_REVIEW_PROMPT_MAX_CHARS=1000000
# 계획 질문 후속 요청·재시작 추가 한도
# CODEWITH_PLAN_FOLLOWUP_MAX_CALLS=24
# 프로젝트 코드 전달 예산(UTF-8 bytes)
# CODEWITH_PROJECT_CONTEXT_MAX_BYTES=100000
# 파일별 검색에 사용하는 앞부분 문자 수
# CODEWITH_PROJECT_SEARCH_PREVIEW_CHARS=12000

# 계획 검사 실패 시 지적된 부분을 자동 수정하는 횟수 (기본 2회)
# CODEWITH_PLAN_VALIDATION_RETRIES=2

# 직접 HTTPS를 제공할 때 인증서와 개인키 경로를 함께 지정
# CODEWITH_TLS_CERT=.codewith/tls/codewith.test.pem
# CODEWITH_TLS_KEY=.codewith/tls/codewith.test-key.pem

# Default UI language at build time: en or ko. Browser preference takes priority.
VITE_DEFAULT_LOCALE=en
